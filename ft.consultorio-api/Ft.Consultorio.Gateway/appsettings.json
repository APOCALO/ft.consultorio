{
  "ServiceDefaults": {
    "SerilogSettings": {
      "Using": [
        "Serilog.Sinks.Console",
        "Serilog.Sinks.Async"
      ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Information",
          "Microsoft.AspNetCore": "Warning",
          "Yarp": "Information",
          "System": "Warning"
        }
      },
      "Enrich": [
        "FromLogContext"
      ],
      "WriteTo": [
        {
          "Name": "Async",
          "Args": {
            "configure": [
              {
                "Name": "Console"
              }
            ]
          }
        }
      ]
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "https://www.ftconsultorio.co",
      "https://ftconsultorio.co"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/msauth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/msauth"
          }
        ]
      },
      "medicalrecords": {
        "ClusterId": "medicalrecords",
        "Match": {
          "Path": "/msmedicalrecords/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/msmedicalrecords"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth_destination": {
            "Address": "https+http://ftconsultorio-auth"
          }
        }
      },
      "medicalrecords": {
        "Destinations": {
          "medicalrecords_destination": {
            "Address": "https+http://ftconsultorio-medicalrecords"
          }
        }
      }
    }
  },
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
